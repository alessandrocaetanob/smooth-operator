# Normalize line endings to LF on commit
* text=auto

# Shell scripts must always use LF (Windows CRLF breaks shebangs on Linux)
*.sh text eol=lf

# Config/data formats
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.md text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff2 binary
*.ttf binary
*.eot binary
*.woff binary
