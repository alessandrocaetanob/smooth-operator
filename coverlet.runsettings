<?xml version="1.0" encoding="utf-8"?>
<!--
  coverlet.runsettings — controls coverage collection during `dotnet test`.
  Applied via:  dotnet test --settings coverlet.runsettings
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Output directory relative to the test project (overridden in CI). -->
          <Format>cobertura</Format>
          <!-- Exclude auto-generated migration code and test infrastructure. -->
          <Exclude>
            [SmoothOperator.Infrastructure]SmoothOperator.Infrastructure.Migrations.*,
            [SmoothOperator.Api.Tests]*,
            [SmoothOperator.Application.Tests]*,
            [SmoothOperator.Domain.Tests]*,
            [SmoothOperator.Infrastructure.Tests]*
          </Exclude>
          <ExcludeByFile>
            **/Migrations/*.cs,
            **/obj/**/*.cs
          </ExcludeByFile>
          <!-- Include only production code. -->
          <Include>
            [SmoothOperator.*]*
          </Include>
          <!-- Count branch coverage. -->
          <SkipAutoProps>true</SkipAutoProps>
          <SingleHit>false</SingleHit>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
