# ============================================================
# Smooth Operator - repository-wide ignore rules
# ============================================================

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# IDE/editor files
/.vs/
/.vscode/
.vscode-test/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.tmp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and local secrets
.env
.env.*
!.env.example
!.env.*.example

# Docker secrets directory — contains sensitive key files mounted at runtime.
# Only .gitkeep (to preserve directory structure) is tracked.
secrets/
!secrets/.gitkeep

# .NET / C#
**/bin/
**/obj/
**/TestResults/
**/coverage/
**/coveragereport/
**/coverage.cobertura.xml
*.nupkg
*.snupkg

# Backend generated/local files
backend/bin/
backend/obj/
backend/Properties/
backend/appsettings.Local.json
backend/appsettings.*.local.json
# Real appsettings live in backend/src/SmoothOperator.Api/ — ignore root-level ones
backend/appsettings.json
backend/appsettings.*.json

# Frontend generated files
frontend/node_modules/
frontend/dist/
frontend/tmp/
frontend/out-tsc/
frontend/.angular/cache/
frontend/coverage/
frontend/.sass-cache/
frontend/npm_output.log

# Package manager caches
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Local databases
*.sqlite
*.sqlite3
*.db

# Local tooling metadata
.claude/
*.lscache

# Local review/planning guides
JULES.md

# Editor / IDE local config (may contain secrets)
.cursor/
.vscode/settings.json

# Brainstorming companion workspace
.superpowers/
