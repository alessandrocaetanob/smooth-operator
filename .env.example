# ─────────────────────────────────────────────────────────────────────────────
# smooth-operator — environment variable reference
#
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to source control.
# In production, inject these via Docker secrets, Azure Key Vault, or your
# platform's secrets manager.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Docker Compose service name as host)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=smoothoperator;Username=postgres;Password=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────────────────
ConnectionStrings__Redis=redis:6379

# ── Encryption ────────────────────────────────────────────────────────────────
# 64-character hex string (256-bit key). Generate with:
#   openssl rand -hex 32
Encryption__Key=CHANGE_ME_64_HEX_CHARS

# ── JWT ───────────────────────────────────────────────────────────────────────
# ≥32-byte random secret. Generate with:
#   openssl rand -hex 32
Jwt__Key=CHANGE_ME_AT_LEAST_32_BYTES
Jwt__Issuer=smooth-operator
Jwt__Audience=smooth-operator-api
# Token lifetimes (optional, these are the defaults)
# Jwt__AccessTokenExpirationMinutes=60
# Jwt__RefreshTokenExpirationDays=7

# ── Guacd (Apache Guacamole daemon) ───────────────────────────────────────────
Guacd__Host=guacd
Guacd__Port=4822

# ── Application URLs ──────────────────────────────────────────────────────────
AppUrls__App=http://localhost:4200
AppUrls__Frontend=http://localhost:4200
# AppUrls__AllowedOrigins=http://localhost:4200,https://your-domain.com

# ── Azure Entra ID (SSO, optional) ───────────────────────────────────────────
# Uncomment to enable Entra ID / Azure AD SSO
# AzureAd__Instance=https://login.microsoftonline.com/
# AzureAd__TenantId=your-tenant-id
# AzureAd__ClientId=your-client-id
# AzureAd__ClientSecret=CHANGE_ME

# ── SMTP (optional, for invite emails) ───────────────────────────────────────
# Smtp__Host=smtp.example.com
# Smtp__Port=587
# Smtp__Username=user@example.com
# Smtp__Password=CHANGE_ME
# Smtp__FromAddress=noreply@example.com

# ── OpenTelemetry (optional observability) ────────────────────────────────────
# Start with: docker compose --profile observability up -d
Otel__Endpoint=http://tempo:4317
Otel__ServiceName=smooth-operator-backend

# ── Frontend runtime config ───────────────────────────────────────────────────
# These are passed to the nginx container and rendered into /config/config.json
# by entrypoint.sh at startup. Same Docker image works across all environments.
APP_HELP_URL=http://localhost:3000
APP_DOCS_URL=http://localhost:3000
APP_FEATURE_FLAGS={}

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
