{
  "AllowedHosts": "*",

  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100",
          "labels": [{ "key": "app", "value": "smooth-operator" }],
          "propertiesAsLabels": ["level", "EnvironmentName"],
          "textFormatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentName"],
    "Properties": { "Application": "smooth-operator" }
  },

  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },

  "Jwt": {
    "Issuer": "smooth-operator",
    "Audience": "smooth-operator-api",
    "Key": ""
  },

  "Guacd": {
    "Host": "guacd",
    "Port": 4822
  },

  "Otel": {
    "Endpoint": "http://tempo:4317",
    "ServiceName": "smooth-operator-backend"
  },

  "Encryption": {
    "Key": ""
  },

  "AppUrls": {
    "App": "",
    "Frontend": "",
    "AllowedOrigins": []
  },

  "DataProtection": {
    "KeysPath": "/data/protection-keys"
  },

  "Auth": {
    "AllowSelfRegister": false
  },

  "RateLimit": {
    "Global": { "PermitLimit": 100, "QueueLimit": 0, "WindowSeconds": 60 },
    "Auth": { "PermitLimit": 5, "QueueLimit": 0, "WindowSeconds": 60 }
  }
}
