{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=smoothoperator;Username=postgres;Password=postgres;Multiplexing=true;MaxPoolSize=100;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "smooth-operator",
    "Audience": "smooth-operator-api",
    "_comment": "DEV ONLY. Replace with a strong random secret (\u003E=32 bytes) in production via Jwt__Key env var or a secret store.",
    "Key": "dev-only-jwt-signing-key-please-change-me-min-32-chars-1234567890"
  },
  "Guacd": {
    "Host": "localhost",
    "Port": 4822
  },
  "Otel": {
    "Endpoint": "",
    "ServiceName": "smooth-operator-backend"
  },
  "_comment_encryption": "DEV ONLY 64-hex-char (32-byte) AES key. Use a secrets manager in production.",
  "Encryption": {
    "Key": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  },

  "AppUrls": {
    "App": "http://localhost:5000",
    "Frontend": "http://localhost:4200"
  },

  "Auth": {
    "AllowSelfRegister": true
  },

  "RateLimit": {
    "Global": { "PermitLimit": 100, "QueueLimit": 0, "WindowSeconds": 60 },
    "Auth": { "PermitLimit": 5, "QueueLimit": 0, "WindowSeconds": 60 }
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "smooth-operator-api"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  }
}