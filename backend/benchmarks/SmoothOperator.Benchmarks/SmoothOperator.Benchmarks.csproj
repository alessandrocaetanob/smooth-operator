<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Micro-benchmark project. Intentionally NOT added to smooth-operator.sln so it
    is excluded from `dotnet test` and the CI build. Run it manually in Release
    from the SmoothOperator.Benchmarks directory:  dotnet run -c Release
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SmoothOperator.Benchmarks</RootNamespace>
    <AssemblyName>SmoothOperator.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

</Project>
