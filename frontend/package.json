{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage && node scripts/filter-coverage.js",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "analyze": "ng build --configuration production --stats-json && webpack-bundle-analyzer dist/frontend/browser/stats.json",
    "analyze:upload": "npx --yes @codecov/bundle-analyzer ./dist/frontend/browser --bundle-name=smooth-operator-frontend"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@types/qrcode": "^1.5.6",
    "chart.js": "^4.5.1",
    "guacamole-common-js": "^1.5.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.1.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.9.1",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "webpack-bundle-analyzer": "^5.3.2"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
